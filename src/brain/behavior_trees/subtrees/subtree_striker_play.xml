<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="StrikerPlay">
      <ReactiveSequence>
         <SelfLocate mode="trust_direction" />
         <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="Wait for opponent kickoff">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <!-- Once the referee releases STOP, RobotFindBall moves into a safe observation area for an opponent goal kick or corner kick. -->
            <Sequence _while="!(ball_location_known || tm_ball_pos_reliable)">
               <CamFindBall />
                           <RobotFindBall continuous_spin="true" />
            </Sequence>
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="Normal play: our kickoff or opponent has kicked off">
            <Sequence _while="ball_out">
               <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
               <GoBackInField />
               <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
            </Sequence>
            <ReactiveSequence _while="!ball_out">
               <ReactiveSequence >
                  <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <CalcKickDir cross_threshold="-1.0" />
                  <Sequence>
                     <ReactiveSequence>
                        <StrikerDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.0" />
                        <Sequence _while="decision=='find'">
                           <CamFindBall />
               <RobotFindBall continuous_spin="true" />
                        </Sequence>
                     </ReactiveSequence>
                        <Assist _while="decision == 'assist'" vx_limit = "1.0" vy_limit="1.0" />
                        <Chase   _while="decision == 'chase'"  vx_limit="1.8"  vy_limit="0.4"  vtheta_limit="1.0"  dist="0.1" safe_dist="0.5" />
                        <RLVisionKick _while="decision == 'auto_visual_kick'" min_msec_kick="1500" max_msec_kick="7000" range="6.0"/> -->
                        <Adjust _while="decision =='adjust'" turn_threshold="0.5" range="0.4" vx_limit="0.7" vy_limit="0.6" vtheta_limit="1.5" vtheta_factor="1.5" tangential_speed_far="0.7" tangential_speed_near="0.15" near_threshold="0.8" no_turn_threshold="0.1" turn_first_threshold="0.5" />
                        <Kick _while="decision == 'kick'" speed_limit="0.9" min_msec_kick="1000" msecs_stablize="1000"/> -->
                        <Kick _while="decision == 'power_shoot'" speed_limit="1.0" min_msec_kick="1200" msecs_stablize="1000"/>
                        <Kick _while="decision == 'cross'" speed_limit="0.6" min_msec_kick="600"/> -->
                  </Sequence>
               </ReactiveSequence>
            </ReactiveSequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
