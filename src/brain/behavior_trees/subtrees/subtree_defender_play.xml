<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="DefenderPlay">
      <ReactiveSequence>
         <SelfLocate mode="trust_direction" />
         <SubTree ID="Locate" _autoremap="true" />
         <ReactiveSequence>
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <ReactiveSequence>
               <DefenderDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.0" />
               <Sequence _while="decision == 'find'">
                  <CamFindBall />
                  <RobotFindBall continuous_spin="true" />
               </Sequence>
               <Chase   _while="decision == 'chase'"  vx_limit="1.8"  vy_limit="0.4"  vtheta_limit="1.0"  dist="0.1" safe_dist="0.5" />
               <RLVisionKick _while="decision == 'auto_visual_kick'" min_msec_kick="1500" max_msec_kick="7000" range="6.0"/>
               <Adjust  _while="decision == 'adjust'" turn_threshold="0.2" range="0.3" vx_limit="0.3" vy_limit="0.2" vtheta_limit="1.0" />
               <Kick    _while="decision == 'kick'" speed_limit="0.9" min_msec_kick="1000" msecs_stablize="1000" />
               <Cover   _while="decision == 'cover'" vx_limit="1.2" vy_limit="0.6" vtheta_limit="1.5" />
               <Cdm     _while="decision == 'cdm'" vx_limit="1.2" vy_limit="0.6" vtheta_limit="1.5" />
               <KickoffSpot _while="decision == 'kickoff_spot'" vx_limit="1.0" vy_limit="0.6" vtheta_limit="1.0" />
            </ReactiveSequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
